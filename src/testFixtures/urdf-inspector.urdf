<robot name="Inspection arm">
<material name="blue"><color rgba="0.2 0.5 0.8 1"/></material>
<link name="base"><visual><geometry><box size="0.18 0.18 0.1"/></geometry><material name="blue"/></visual><collision><geometry><box size="0.2 0.2 0.12"/></geometry></collision></link>
<link name="arm"><visual><origin xyz="0 0 0.2"/><geometry><cylinder radius="0.035" length="0.4"/></geometry></visual><collision><origin xyz="0 0 0.1"/><geometry><sphere radius="0.05"/></geometry></collision><collision><origin xyz="0 0 0.3"/><geometry><box size="0.1 0.1 0.15"/></geometry></collision><inertial><origin xyz="0 0 0.2" rpy="0.1 0.2 0.3"/><mass value="2"/><inertia ixx="0.04" ixy="0.001" ixz="0" iyy="0.05" iyz="0" izz="0.02"/></inertial></link>
<link name="finger"/><joint name="shoulder" type="revolute"><parent link="base"/><child link="arm"/><origin xyz="0 0 0.1"/><axis xyz="0 1 0"/><limit lower="-1" upper="1.5" effort="10" velocity="2"/></joint>
<joint name="follower" type="revolute"><parent link="arm"/><child link="finger"/><limit lower="-3" upper="3"/><mimic joint="shoulder" multiplier="-2" offset="0.1"/></joint></robot>