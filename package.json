{
  "name": "easy-debug",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "npm run test:frontend && npm run test:rust && npm run test:bridge && npm run test:deploy",
    "test:frontend": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:bridge": "c++ -std=c++17 -Wall -Wextra -pedantic -Ibridge/easy_debug_bridge/include bridge/easy_debug_bridge/test/test_bridge_core.cpp -o /tmp/easy_debug_bridge_core_test && /tmp/easy_debug_bridge_core_test",
    "tauri": "tauri",
    "test:deploy": "node --test scripts/deploy-bridge.node-test.mjs",
    "deploy:bridge": "node scripts/deploy-bridge.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.3.0",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@types/three": "^0.179.0",
    "jq-wasm": "^3.0.0-jq-1.8.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.179.1",
    "urdf-loader": "^0.12.6"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^30.0.1",
    "typescript": "~5.8.3",
    "vite": "^7.1.3",
    "vitest": "^4.1.10"
  }
}
